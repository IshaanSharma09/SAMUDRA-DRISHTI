ENVIRONMENT=development
PROJECT_NAME="Samundra Drishti Core API"
DB_ECHO=false

POSTGRES_SERVER=localhost
POSTGRES_PORT=6432
POSTGRES_DB=samundra_drishti
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_SECRET_KEY=replace_with_cryptographically_secure_256bit_random_secret_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME=samundra_access_token
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=300
GLOBAL_RATE_LIMIT=100/minute
AUTH_RATE_LIMIT=5/minute
